  function buscarPerfilDestino(destino) {
    const destinoNormalizado = normalizarTexto(destino);

    return perfilesDestinoV1.find(perfil =>
      perfil.claves.some(clave =>
        destinoNormalizado.includes(normalizarTexto(clave))
      )
    ) || null;
  }


  function nivelPresupuesto(presupuesto) {
    const niveles = {
      "Económico": 1,
      "Medio": 2,
      "Confort": 3,
      "Premium": 4
    };

    return niveles[presupuesto] || null;
  }


  function calcularCompatibilidadZarevoa(datos) {
    const perfil = buscarPerfilDestino(datos.destino);
    const razones = [];

    // Un destino aún no cargado en la base V1 no recibe una
    // compatibilidad falsa. El resultado queda deliberadamente limitado.
    if (!perfil) {
      let preliminar = 50;

      if (datos.fechaInicio && datos.fechaFin) preliminar += 4;
      if (datos.presupuesto) preliminar += 4;
      if (datos.intereses.length > 0) preliminar += Math.min(6, datos.intereses.length * 2);
      if (datos.tipo) preliminar += 3;
      if (datos.alojamiento) preliminar += 2;
      if (datos.movilidad) preliminar += 2;

      preliminar = Math.min(71, preliminar);

      return {
        porcentaje: preliminar,
        detalle: "Resultado preliminar: este destino aún no tiene un perfil específico en ZAREVOA Engine V1. El porcentaje refleja la calidad de la información ingresada, no una validación completa del destino."
      };
    }

    let puntos = 54;

    if (datos.intereses.length > 0) {
      const afinidades = datos.intereses.map(interes => perfil.intereses[interes] || 60);
      const promedio = afinidades.reduce((a, b) => a + b, 0) / afinidades.length;
      puntos += (promedio / 100) * 22;

      const mejores = datos.intereses.filter(interes => (perfil.intereses[interes] || 0) >= 90);
      if (mejores.length > 0) {
        razones.push("alta afinidad con " + mejores.join(", ").toLowerCase());
      }
    } else {
      puntos += 10;
      razones.push("perfil de intereses aún abierto");
    }

    const nivelUsuario = nivelPresupuesto(datos.presupuesto);
    if (nivelUsuario) {
      const diferencia = Math.abs(nivelUsuario - perfil.presupuesto);
      if (diferencia === 0) {
        puntos += 10;
        razones.push("presupuesto bien alineado");
      } else if (diferencia === 1) {
        puntos += 6;
        razones.push("presupuesto razonablemente compatible");
      } else if (diferencia === 2) {
        puntos += 1;
        razones.push("el presupuesto podría requerir ajustes");
      } else {
        puntos -= 7;
        razones.push("presupuesto con baja afinidad para este destino");
      }
    }

    if (datos.movilidad) {
      if (perfil.movilidad.includes(datos.movilidad)) {
        puntos += 6;
        razones.push("movilidad compatible");
      } else {
        puntos += 1;
        razones.push("conviene revisar la movilidad elegida");
      }
    }

    if (datos.ritmo) {
      if (perfil.ritmos.includes(datos.ritmo)) {
        puntos += 4;
      } else {
        puntos += 1;
      }
    }

    if (datos.tipo) {
      if (perfil.tipos.includes(datos.tipo)) {
        puntos += 4;
      } else {
        puntos += 1;
      }
    }

    if (datos.mascota === "Sí") {
      if (perfil.mascota >= 70) {
        puntos += 3;
        razones.push("buena viabilidad para viajar con mascota");
      } else if (perfil.mascota >= 50) {
        puntos -= 1;
        razones.push("viajar con mascota requiere planificación adicional");
      } else {
        puntos -= 6;
        razones.push("viajar con mascota puede ser complejo");
      }
    }

    if (datos.fechaInicio) {
      const mes = new Date(datos.fechaInicio + "T00:00:00").getMonth() + 1;

      if (perfil.mesesFavorables.includes(mes)) {
        puntos += 5;
        razones.push("temporada favorable");
      } else if (perfil.mesesAceptables.includes(mes)) {
        puntos += 2;
        razones.push("temporada aceptable");
      } else {
        puntos -= 3;
        razones.push("la temporada puede reducir la compatibilidad");
      }
    }

    if (datos.flexibilidad === "Puedo mover algunos días") puntos += 1;
    if (datos.flexibilidad === "Muy flexible") puntos += 2;

    puntos = Math.round(Math.max(38, Math.min(97, puntos)));

    let detalle = "Compatibilidad calculada cruzando el destino con tu perfil.";
    if (razones.length > 0) {
      detalle += " Factores principales: " + razones.slice(0, 4).join("; ") + ".";
    }

    return {
      porcentaje: puntos,
      detalle: detalle
    };
  }


  function crearViaje() {

    const origen =
      obtenerValor("origen");

    const destino =
      obtenerValor("destino");

    const fechaInicio =
      obtenerValor("fechaInicio");

    const fechaFin =
      obtenerValor("fechaFin");

    const viajeros =
      obtenerValor("viajeros") || "1";

    const edades =
      obtenerValor("edades");

    const presupuesto =
      obtenerValor("presupuesto");

    const ritmo =
      obtenerValor("ritmo") ||
      "Equilibrado";

    const tipo =
      obtenerValor("tipo");

    const alojamiento =
      obtenerValor("alojamiento");

    const mascota =
      obtenerValor("mascota");

    const movilidad =
      obtenerValor("movilidad");

    const seguro =
      obtenerValor("seguro");

    const flexibilidad =
      obtenerValor("flexibilidad");

    const comentarios =
      obtenerValor("comentarios");


    const mensajeError =
      document.getElementById(
        "mensajeError"
      );

    mensajeError.style.display = "none";
    mensajeError.textContent = "";


    if (!destino) {

      mensajeError.textContent =
        "Escribe el destino que quieres visitar para poder crear tu viaje.";

      mensajeError.style.display =
        "block";

      document.getElementById(
        "destino"
      ).focus();

      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });

      return;
    }


    const duracion =
      calcularDuracion(
        fechaInicio,
        fechaFin
      );


    if (duracion === -1) {

      mensajeError.textContent =
        "La fecha de regreso no puede ser anterior a la fecha de inicio.";

      mensajeError.style.display =
        "block";

      return;
    }


    const interesesSeleccionados =
      Array.from(
        document.querySelectorAll(
          'input[name="intereses"]:checked'
        )
      ).map(
        elemento => elemento.value
      );


    document.getElementById(
      "tituloResultado"
    ).textContent =
      "Tu viaje a " + destino;


    let subtitulo =
      "Una primera propuesta creada según tu perfil de viaje.";

    if (origen) {
      subtitulo =
        "Desde " +
        origen +
        " hacia " +
        destino +
        ". Una primera propuesta creada según tu perfil de viaje.";
    }

    document.getElementById(
      "subtituloResultado"
    ).textContent =
      subtitulo;


    document.getElementById(
      "viajerosResultado"
    ).textContent =
      viajeros +
      (
        Number(viajeros) === 1
        ? " persona"
        : " personas"
      );


    if (duracion) {

      document.getElementById(
        "duracionResultado"
      ).textContent =
        duracion +
        (
          duracion === 1
          ? " día"
          : " días"
        );

    } else {

      document.getElementById(
        "duracionResultado"
      ).textContent =
        "Fechas flexibles";

    }


    let estiloTexto = ritmo;

    if (presupuesto) {
      estiloTexto +=
        " · " + presupuesto;
    }

    document.getElementById(
      "estiloResultado"
    ).textContent =
      estiloTexto;


    if (
      interesesSeleccionados.length > 0
    ) {

      document.getElementById(
        "interesesResultado"
      ).textContent =
        "Daremos prioridad a: " +
        interesesSeleccionados.join(", ") +
        ".";

    } else {

      document.getElementById(
        "interesesResultado"
      ).textContent =
        "No seleccionaste intereses específicos, por lo que construiremos una propuesta equilibrada y variada.";

    }


    const badges = [];


    if (tipo) {
      badges.push(tipo);
    }

    if (ritmo) {
      badges.push("Ritmo " + ritmo);
    }

    if (presupuesto) {
      badges.push(
        "Presupuesto " + presupuesto
      );
    }

    if (alojamiento) {
      badges.push(alojamiento);
    }

    if (movilidad) {
      badges.push(movilidad);
    }

    if (mascota === "Sí") {
      badges.push("Viaje con mascota");
    }

    if (seguro) {
      badges.push(
        "Seguro: " + seguro
      );
    }

    if (flexibilidad) {
      badges.push(flexibilidad);
    }

    if (edades) {
      badges.push(
        "Edades: " + edades
      );
    }

    if (comentarios) {
      badges.push(
        "Preferencias especiales"
      );
    }


    const badgesResultado =
      document.getElementById(
        "badgesResultado"
      );

    badgesResultado.innerHTML = "";


    if (badges.length === 0) {

      const badge =
        document.createElement("span");

      badge.className = "badge";

      badge.textContent =
        "Perfil personalizado";

      badgesResultado.appendChild(
        badge
      );

    } else {

      badges.forEach(
        texto => {

          const badge =
            document.createElement(
              "span"
            );

          badge.className =
            "badge";

          badge.textContent =
            texto;

          badgesResultado.appendChild(
            badge
          );

        }
      );

    }


    const resultadoCompatibilidad =
      calcularCompatibilidadZarevoa({
        destino: destino,
        fechaInicio: fechaInicio,
        fechaFin: fechaFin,
        presupuesto: presupuesto,
        ritmo: ritmo,
        tipo: tipo,
        alojamiento: alojamiento,
        mascota: mascota,
        movilidad: movilidad,
        flexibilidad: flexibilidad,
        intereses: interesesSeleccionados
      });


    document.getElementById(
      "compatibilidadResultado"
    ).textContent =
      resultadoCompatibilidad.porcentaje + "%";


    document.getElementById(
      "compatibilidadDetalle"
    ).textContent =
      resultadoCompatibilidad.detalle;


    crearItinerarioInicial(
      destino,
      duracion,
      ritmo,
      interesesSeleccionados,
      movilidad,
      presupuesto,
      alojamiento,
      viajeros
    );


    document.getElementById(
      "formulario"
    ).style.display =
      "none";


    document.getElementById(
      "resultado"
    ).style.display =
      "block";


    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });

  }


  function volverFormulario() {

    document.getElementById(
      "resultado"
    ).style.display =
      "none";


    document.getElementById(
      "formulario"
    ).style.display =
      "block";


    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });

  }

