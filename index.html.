<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>ZAREVOA | Plan Your World</title>

  <style>
    :root {
      --azul: #071b35;
      --azul2: #0d294b;
      --turquesa: #19c7c1;
      --turquesa2: #10aaa6;
      --blanco: #ffffff;
      --gris: #f4f7fa;
      --gris2: #e4eaf0;
      --texto: #24354a;
      --sombra: 0 12px 35px rgba(7, 27, 53, 0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--gris);
      color: var(--texto);
      line-height: 1.5;
    }

    header {
      background: var(--azul);
      color: white;
      padding: 18px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 4px 18px rgba(0,0,0,0.12);
    }

    .marca {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-z {
      width: 46px;
      height: 46px;
      border-radius: 13px;
      background: var(--turquesa);
      color: var(--azul);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 27px;
      font-weight: 900;
    }

    .marca-texto h1 {
      font-size: 24px;
      letter-spacing: 2px;
      margin: 0;
    }

    .marca-texto span {
      display: block;
      font-size: 10px;
      letter-spacing: 3px;
      color: var(--turquesa);
      margin-top: 1px;
    }

    nav {
      display: flex;
      gap: 20px;
      align-items: center;
    }

    nav a {
      text-decoration: none;
      color: white;
      font-size: 14px;
      opacity: 0.9;
    }

    nav a:hover {
      color: var(--turquesa);
    }

    .hero {
      background:
        linear-gradient(
          135deg,
          rgba(7,27,53,0.98),
          rgba(13,41,75,0.92)
        );
      color: white;
      padding: 65px 20px 85px;
      text-align: center;
    }

    .hero-contenido {
      max-width: 900px;
      margin: auto;
    }

    .hero .mini {
      color: var(--turquesa);
      font-weight: bold;
      letter-spacing: 2px;
      font-size: 13px;
      margin-bottom: 12px;
    }

    .hero h2 {
      font-size: clamp(35px, 6vw, 60px);
      line-height: 1.05;
      margin-bottom: 18px;
    }

    .hero h2 span {
      color: var(--turquesa);
    }

    .hero p {
      font-size: 18px;
      max-width: 700px;
      margin: auto;
      opacity: 0.92;
    }

    .contenedor {
      width: min(1100px, 92%);
      margin: -45px auto 70px;
      position: relative;
      z-index: 2;
    }

    .panel {
      background: white;
      border-radius: 22px;
      padding: 32px;
      box-shadow: var(--sombra);
    }

    .titulo-panel {
      text-align: center;
      margin-bottom: 30px;
    }

    .titulo-panel h3 {
      color: var(--azul);
      font-size: 28px;
      margin-bottom: 8px;
    }

    .titulo-panel p {
      color: #637083;
    }

    .bloque {
      margin-bottom: 30px;
      padding-bottom: 27px;
      border-bottom: 1px solid var(--gris2);
    }

    .bloque:last-of-type {
      border-bottom: none;
    }

    .bloque-titulo {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }

    .numero {
      width: 35px;
      height: 35px;
      border-radius: 50%;
      background: var(--turquesa);
      color: var(--azul);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
    }

    .bloque-titulo h4 {
      font-size: 20px;
      color: var(--azul);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .campo {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .campo.ancho {
      grid-column: 1 / -1;
    }

    label {
      font-size: 14px;
      font-weight: 700;
      color: var(--azul);
    }

    input,
    select,
    textarea {
      width: 100%;
      border: 1px solid #cad4df;
      border-radius: 11px;
      padding: 13px 14px;
      font-size: 15px;
      color: var(--texto);
      background: white;
      outline: none;
      transition: 0.2s;
    }

    textarea {
      min-height: 105px;
      resize: vertical;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--turquesa);
      box-shadow: 0 0 0 3px rgba(25,199,193,0.12);
    }

    .ayuda {
      font-size: 12px;
      color: #788698;
    }

    .intereses {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .interes {
      position: relative;
    }

    .interes input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .interes label {
      min-height: 92px;
      border: 1px solid #d7dee6;
      border-radius: 15px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      cursor: pointer;
      transition: 0.2s;
      padding: 12px;
      gap: 6px;
      font-weight: 600;
    }

    .interes label .icono {
      font-size: 25px;
    }

    .interes input:checked + label {
      background: rgba(25,199,193,0.12);
      border-color: var(--turquesa);
      color: var(--azul);
      box-shadow: 0 5px 15px rgba(25,199,193,0.15);
    }

    .acciones {
      display: flex;
      justify-content: center;
      margin-top: 10px;
    }

    .boton-principal {
      border: none;
      background: var(--turquesa);
      color: var(--azul);
      font-weight: 800;
      font-size: 16px;
      border-radius: 13px;
      padding: 16px 28px;
      cursor: pointer;
      min-width: 240px;
      transition: 0.2s;
    }

    .boton-principal:hover {
      background: var(--turquesa2);
      transform: translateY(-1px);
    }

    .mensaje-error {
      display: none;
      background: #fff1f1;
      color: #a22929;
      border: 1px solid #ffd2d2;
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 20px;
      font-size: 14px;
    }

    /* RESULTADO */

    #resultado {
      display: none;
    }

    .resultado-cabecera {
      background:
        linear-gradient(
          135deg,
          var(--azul),
          var(--azul2)
        );
      border-radius: 18px;
      color: white;
      padding: 30px;
      margin-bottom: 25px;
    }

    .resultado-cabecera .pequeno {
      color: var(--turquesa);
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: 2px;
      font-weight: bold;
      margin-bottom: 8px;
    }

    .resultado-cabecera h2 {
      font-size: 34px;
      margin-bottom: 8px;
    }

    .resultado-cabecera p {
      opacity: 0.88;
    }

    .compatibilidad {
      margin-top: 18px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,255,255,0.12);
      padding: 9px 13px;
      border-radius: 30px;
      color: white;
      font-weight: bold;
    }

    .compatibilidad strong {
      color: var(--turquesa);
    }

    .compatibilidad-detalle {
      margin-top: 10px;
      max-width: 760px;
      font-size: 13px;
      line-height: 1.5;
      opacity: 0.9;
    }

    .resumen-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    .tarjeta-resumen {
      border: 1px solid var(--gris2);
      background: #fff;
      border-radius: 15px;
      padding: 18px;
    }

    .tarjeta-resumen small {
      display: block;
      color: #738195;
      margin-bottom: 5px;
    }

    .tarjeta-resumen strong {
      color: var(--azul);
      font-size: 16px;
    }

    .seccion-resultado {
      border: 1px solid var(--gris2);
      border-radius: 16px;
      padding: 22px;
      margin-bottom: 18px;
      background: white;
    }

    .seccion-resultado h3 {
      color: var(--azul);
      margin-bottom: 14px;
      font-size: 20px;
    }

    .badges {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
    }

    .badge {
      background: rgba(25,199,193,0.12);
      color: var(--azul);
      border: 1px solid rgba(25,199,193,0.4);
      padding: 8px 12px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: 700;
    }

    .itinerario {
      display: grid;
      gap: 14px;
    }

    .dia {
      border-left: 4px solid var(--turquesa);
      background: #f8fafc;
      padding: 16px;
      border-radius: 0 12px 12px 0;
    }

    .dia strong {
      display: block;
      color: var(--azul);
      margin-bottom: 8px;
    }

    .dia-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
      font-size: 12px;
      color: #5f6f82;
    }

    .dia-meta span {
      background: white;
      border: 1px solid #dfe8ee;
      border-radius: 999px;
      padding: 5px 9px;
    }

    .tramo-dia {
      display: grid;
      grid-template-columns: 88px 1fr;
      gap: 10px;
      padding: 7px 0;
      border-top: 1px solid #e8eef2;
      line-height: 1.45;
    }

    .tramo-dia:first-of-type {
      border-top: 0;
    }

    .tramo-dia b {
      color: #0b6670;
      font-size: 13px;
    }

    .consejo-dia {
      margin-top: 10px;
      padding: 10px 12px;
      border-radius: 10px;
      background: rgba(25,199,193,0.09);
      color: #31545b;
      font-size: 13px;
    }

    .ruta-viaje {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
    }

    .ruta-parada {
      background: #f8fafc;
      border: 1px solid #dfe8ee;
      border-radius: 12px;
      padding: 10px 12px;
      color: var(--azul);
      font-weight: 700;
      font-size: 13px;
    }

    .ruta-flecha {
      color: var(--turquesa);
      font-weight: 900;
    }

    .presupuesto-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .presupuesto-item {
      background: #f8fafc;
      border: 1px solid #e1e9ee;
      border-radius: 12px;
      padding: 12px;
    }

    .presupuesto-item small {
      display: block;
      color: #6b7a8c;
      margin-bottom: 5px;
    }

    .presupuesto-item strong {
      color: var(--azul);
    }

    .alertas-viaje {
      display: grid;
      gap: 9px;
    }

    .alerta-viaje {
      background: #fffaf0;
      border: 1px solid #f1dfb8;
      border-radius: 12px;
      padding: 12px 14px;
      color: #5e4b28;
      line-height: 1.45;
    }

    .base-viaje {
      font-size: 12px;
      font-weight: 800;
      color: #0b6670;
      text-transform: uppercase;
      letter-spacing: .4px;
      margin-bottom: 6px;
    }

    .nota-engine {
      background: #f0fbfa;
      border: 1px solid #c8efec;
      border-radius: 15px;
      padding: 18px;
      color: #31545b;
      margin-top: 20px;
    }

    .boton-secundario {
      background: white;
      border: 1px solid var(--azul);
      color: var(--azul);
      border-radius: 12px;
      font-weight: 700;
      padding: 13px 20px;
      cursor: pointer;
    }

    footer {
      background: var(--azul);
      color: white;
      text-align: center;
      padding: 32px 20px;
      margin-top: 50px;
    }

    footer strong {
      color: var(--turquesa);
      letter-spacing: 1px;
    }

    footer p {
      opacity: 0.7;
      font-size: 13px;
      margin-top: 7px;
    }

    @media (max-width: 820px) {
      nav {
        display: none;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .campo.ancho {
        grid-column: auto;
      }

      .intereses {
        grid-template-columns: repeat(2, 1fr);
      }

      .resumen-grid {
        grid-template-columns: 1fr;
      }

      .presupuesto-grid {
        grid-template-columns: 1fr;
      }

      .panel {
        padding: 23px 18px;
      }

      .contenedor {
        width: 94%;
      }
    }

    @media (max-width: 480px) {
      header {
        padding: 14px 16px;
      }

      .marca-texto h1 {
        font-size: 20px;
      }

      .hero {
        padding: 48px 18px 72px;
      }

      .hero p {
        font-size: 16px;
      }

      .intereses {
        grid-template-columns: 1fr 1fr;
      }

      .resultado-cabecera h2 {
        font-size: 27px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="marca">
    <div class="logo-z">Z</div>

    <div class="marca-texto">
      <h1>ZAREVOA</h1>
      <span>PLAN YOUR WORLD</span>
    </div>
  </div>

  <nav>
    <a href="#crear">Crear mi viaje</a>
    <a href="#como-funciona">Cómo funciona</a>
    <a href="#footer">ZAREVOA</a>
  </nav>
</header>


<section class="hero">
  <div class="hero-contenido">

    <div class="mini">
      TU VIAJE · A TU MANERA
    </div>

    <h2>
      Convierte tus ideas en un
      <span>viaje con sentido.</span>
    </h2>

    <p>
      Cuéntanos cómo quieres viajar y ZAREVOA organizará
      una propuesta personalizada según tus fechas,
      presupuesto, ritmo e intereses.
    </p>

  </div>
</section>


<main class="contenedor" id="crear">

  <!-- FORMULARIO -->

  <section class="panel" id="formulario">

    <div class="titulo-panel">
      <h3>Crear mi viaje</h3>
      <p>
        Solo necesitamos algunos datos para comenzar a construir
        tu experiencia ZAREVOA.
      </p>
    </div>

    <div id="mensajeError" class="mensaje-error"></div>


    <!-- BLOQUE 1 -->

    <div class="bloque">

      <div class="bloque-titulo">
        <div class="numero">1</div>
        <h4>Tu viaje</h4>
      </div>

      <div class="grid">

        <div class="campo">
          <label for="origen">¿Desde dónde viajas?</label>
          <input
            type="text"
            id="origen"
            placeholder="Ej: Santiago, Chile"
            autocomplete="off"
          >
        </div>

        <div class="campo">
          <label for="destino">¿A dónde quieres viajar? *</label>
          <input
            type="text"
            id="destino"
            placeholder="Ej: Italia"
            autocomplete="off"
          >
          <span class="ayuda">
            Puedes escribir un país, ciudad o región.
          </span>
        </div>

        <div class="campo">
          <label for="fechaInicio">Fecha de inicio</label>
          <input type="date" id="fechaInicio">
        </div>

        <div class="campo">
          <label for="fechaFin">Fecha de regreso</label>
          <input type="date" id="fechaFin">
        </div>

        <div class="campo">
          <label for="viajeros">Número de viajeros</label>
          <input
            type="number"
            id="viajeros"
            value="2"
            min="1"
            max="20"
          >
        </div>

        <div class="campo">
          <label for="edades">Edades de los viajeros</label>
          <input
            type="text"
            id="edades"
            placeholder="Ej: 54, 44"
          >
        </div>

      </div>
    </div>


    <!-- BLOQUE 2 -->

    <div class="bloque">

      <div class="bloque-titulo">
        <div class="numero">2</div>
        <h4>Tu estilo</h4>
      </div>

      <div class="grid">

        <div class="campo">
          <label for="presupuesto">Presupuesto aproximado</label>

          <select id="presupuesto">
            <option value="">Seleccionar</option>
            <option value="Económico">Económico</option>
            <option value="Medio">Medio</option>
            <option value="Confort">Confort</option>
            <option value="Premium">Premium</option>
          </select>
        </div>

        <div class="campo">
          <label for="ritmo">Ritmo del viaje</label>

          <select id="ritmo">
            <option value="Equilibrado">Equilibrado</option>
            <option value="Relajado">Relajado</option>
            <option value="Intenso">Intenso</option>
          </select>
        </div>

        <div class="campo">
          <label for="tipo">Tipo de viaje</label>

          <select id="tipo">
            <option value="">Seleccionar</option>
            <option value="Pareja">Pareja</option>
            <option value="Familia">Familia</option>
            <option value="Amigos">Amigos</option>
            <option value="Solo">Solo</option>
            <option value="Luna de miel">Luna de miel</option>
            <option value="Aventura">Aventura</option>
            <option value="Negocios + ocio">Negocios + ocio</option>
          </select>
        </div>

        <div class="campo">
          <label for="alojamiento">Alojamiento preferido</label>

          <select id="alojamiento">
            <option value="">Sin preferencia</option>
            <option value="Hostal">Hostal</option>
            <option value="Hotel 3 estrellas">Hotel 3 estrellas</option>
            <option value="Hotel 4 estrellas">Hotel 4 estrellas</option>
            <option value="Hotel 5 estrellas">Hotel 5 estrellas</option>
            <option value="Departamento">Departamento</option>
            <option value="Casa">Casa</option>
            <option value="Mixto">Mixto</option>
          </select>
        </div>

      </div>
    </div>


    <!-- BLOQUE 3 -->

    <div class="bloque">

      <div class="bloque-titulo">
        <div class="numero">3</div>
        <h4>Tus intereses</h4>
      </div>

      <div class="intereses">

        <div class="interes">
          <input
            type="checkbox"
            id="interesNaturaleza"
            name="intereses"
            value="Naturaleza"
          >
          <label for="interesNaturaleza">
            <span class="icono">🌿</span>
            Naturaleza
          </label>
        </div>

        <div class="interes">
          <input
            type="checkbox"
            id="interesCiudad"
            name="intereses"
            value="Ciudad"
          >
          <label for="interesCiudad">
            <span class="icono">🏙️</span>
            Ciudad
          </label>
        </div>

        <div class="interes">
          <input
            type="checkbox"
            id="interesGastronomia"
            name="intereses"
            value="Gastronomía"
          >
          <label for="interesGastronomia">
            <span class="icono">🍷</span>
            Gastronomía
          </label>
        </div>

        <div class="interes">
          <input
            type="checkbox"
            id="interesCultura"
            name="intereses"
            value="Cultura"
          >
          <label for="interesCultura">
            <span class="icono">🏛️</span>
            Cultura
          </label>
        </div>

      </div>

      <div class="grid" style="margin-top:20px;">

        <div class="campo">
          <label for="mascota">¿Viajas con mascota?</label>

          <select id="mascota">
            <option value="No">No</option>
            <option value="Sí">Sí</option>
          </select>
        </div>

      </div>

    </div>


    <!-- BLOQUE 4 -->

    <div class="bloque">

      <div class="bloque-titulo">
        <div class="numero">4</div>
        <h4>Extras</h4>
      </div>

      <div class="grid">

        <div class="campo">
          <label for="movilidad">Movilidad</label>

          <select id="movilidad">
            <option value="">Sin preferencia</option>
            <option value="Transporte público">
              Transporte público
            </option>
            <option value="Auto de alquiler">
              Auto de alquiler
            </option>
            <option value="Traslados privados">
              Traslados privados
            </option>
            <option value="Mixto">
              Mixto
            </option>
          </select>
        </div>

        <div class="campo">
          <label for="seguro">Seguro de viaje</label>

          <select id="seguro">
            <option value="Quiero opciones">
              Quiero opciones
            </option>
            <option value="Ya tengo">
              Ya tengo
            </option>
            <option value="No">
              No por ahora
            </option>
          </select>
        </div>

        <div class="campo">
          <label for="flexibilidad">Flexibilidad de fechas</label>

          <select id="flexibilidad">
            <option value="Fechas fijas">
              Fechas fijas
            </option>
            <option value="Puedo mover algunos días">
              Puedo mover algunos días
            </option>
            <option value="Muy flexible">
              Muy flexible
            </option>
          </select>
        </div>

        <div class="campo ancho">
          <label for="comentarios">
            ¿Hay algo más que debamos saber?
          </label>

          <textarea
            id="comentarios"
            placeholder="Ej: quiero evitar vuelos muy temprano, necesito actividades para niños, celebramos aniversario, prefiero caminar poco..."
          ></textarea>
        </div>

      </div>
    </div>


    <div class="acciones">
      <button
        type="button"
        class="boton-principal"
        onclick="crearViaje()"
      >
        Crear mi viaje ZAREVOA
      </button>
    </div>

  </section>


  <!-- RESULTADO -->

