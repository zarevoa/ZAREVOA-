  function distribuirBases(plan, dias) {
    const total = Math.max(1, dias || 4);
    if (total <= 4) return [{...plan.bases[0], dias: total}];

    let candidatas = [];
    let acumulado = 0;
    for (const base of plan.bases) {
      if (acumulado >= total) break;
      candidatas.push({...base, dias: Math.min(base.min, total - acumulado)});
      acumulado += base.min;
    }
    if (!candidatas.length) candidatas = [{...plan.bases[0], dias: total}];

    let asignados = candidatas.reduce((a,b)=>a+b.dias,0);
    let idx = 0;
    while (asignados < total) {
      candidatas[idx % candidatas.length].dias++;
      asignados++;
      idx++;
    }
    return candidatas.filter(b => b.dias > 0);
  }

