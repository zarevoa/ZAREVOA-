    bases.forEach((base, indiceBase) => {
      for (let local = 1; local <= base.dias; local++, diaGlobal++) {
        const esPrimerDiaViaje = diaGlobal === 1;
        const esUltimoDiaViaje = diaGlobal === totalDias;
