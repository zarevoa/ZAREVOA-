  function calcularDuracion(fechaInicio, fechaFin) {

    if (!fechaInicio || !fechaFin) {
      return null;
    }

    const inicio = new Date(
      fechaInicio + "T00:00:00"
    );

    const fin = new Date(
      fechaFin + "T00:00:00"
    );

    const diferencia =
      fin.getTime() - inicio.getTime();

    if (diferencia < 0) {
      return -1;
    }

    const dias =
      Math.floor(
        diferencia / (1000 * 60 * 60 * 24)
      ) + 1;

    return dias;
  }


